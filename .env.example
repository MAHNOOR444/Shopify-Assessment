# Shopify API credentials.
# These are filled in automatically when you run `shopify app dev` or
# `shopify app config link` and link this project to an app in the Dev
# Dashboard. You never need to commit real values.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# The public URL the app is reachable at.
# During local development `shopify app dev` starts a tunnel and sets this
# for you automatically.
SHOPIFY_APP_URL="https://localhost:3000"

# Access scopes requested during install. Keep in sync with shopify.app.toml.
SCOPES="write_products"

# Optional: comma-separated custom shop domains, if the store uses one.
# SHOP_CUSTOM_DOMAIN=""
